APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database URL: MySQL on localhost/XAMPP with user root and empty password
DATABASE_URL=mysql+pymysql://root:@127.0.0.1:3306/todo_db

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

API_V1_PREFIX=/api/v1
PAGE_SIZE_DEFAULT=20
PAGE_SIZE_MAX=100
BULK_COUNT_DEFAULT=1000
BULK_COUNT_MAX=1000
